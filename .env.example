# Copy to .env and fill in. Every value here is optional — with none of them
# set, `run.py publish` composes sections with its rule-based fallback and
# marks those shards `degraded: true`. Nothing fails.
#
# The real environment always takes precedence over this file, so a secret
# injected by CI wins over a stale .env in the checkout, and
#   OPENCODE_API_KEY=... uv run run.py publish
# wins over both.

# LLM API key, used for section headings and grouping only (never for
# headlines or blurbs — see llm.py). The default endpoint is Gemini's
# OpenAI-compatible API, so a Gemini key from https://ai.google.dev goes here.
# The OPENCODE_* names are historical; any OpenAI-compatible endpoint works.
OPENCODE_API_KEY=

# Optional: a model available on your endpoint.
#OPENCODE_MODEL=gemini-3.5-flash

# Optional: any OpenAI-compatible chat/completions URL.
#OPENCODE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
